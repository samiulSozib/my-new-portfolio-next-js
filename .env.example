# Neon Postgres connection string (Vercel's Neon integration sets this automatically).
# Leave empty for local development: an embedded Postgres (PGlite) is created in ./.pglite instead.
DATABASE_URL=

# Public URL of the site, used in the feed, sitemap, canonical links and password-reset emails.
APP_URL=http://localhost:3000

# Secret used to sign login sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# The admin login created by `npm run db:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

# Vercel Blob read/write token, for the CV and profile photo uploads (set automatically when a Blob store is connected).
BLOB_READ_WRITE_TOKEN=

# Optional: send password-reset emails through Resend. Without it the reset link is printed to the server log.
RESEND_API_KEY=
MAIL_FROM="Site <hello@example.com>"

# Optional: every new newsletter signup is also POSTed here as {email, lang, source}.
NEWSLETTER_WEBHOOK_URL=
